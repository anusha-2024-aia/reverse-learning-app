# Google Gemini AI API Key (Required for evaluation, roadmap, interview & communication AI engines)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Connection URL (PostgreSQL default)
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name

# JWT Authentication Security Settings
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Database Connections
MONGODB_URI=your_mongodb_connection_string_here

# Frontend Application Origin (For CORS policies)
FRONTEND_URL=http://localhost:5173